{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": { "api/*.js": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/dashboard", "destination": "/dashboard/index.html" },
    { "source": "/api/benchmarks", "destination": "/api/benchmarks.js" },
    { "source": "/api/health", "destination": "/api/health.js" },
    { "source": "/api/predict", "destination": "/api/predict.js" },
    { "source": "/api/schema", "destination": "/api/schema.js" },
    { "source": "/", "destination": "/index.html" }
  ]
}
